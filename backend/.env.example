# Copy to backend/.env and fill in. All values are optional — the app runs
# end-to-end with zero configuration (SQLite + rule-based fallbacks).

# Database (defaults to local SQLite). For Postgres:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/fishing
DATABASE_URL=sqlite:///./fishing_copilot.db

# AI layer — without a key the app uses deterministic template plans/explanations.
# ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-opus-4-8
LLM_MAX_TOKENS=1024

# Where the trained model artifact lives (read by the ML inference layer).
# FISHING_MODEL_PATH=ml/artifacts/model.joblib
